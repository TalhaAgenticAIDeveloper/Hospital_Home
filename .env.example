# =============================================================================
# Application
# =============================================================================
APP_ENV=development
APP_NAME=HealthcareSaaS
APP_VERSION=0.1.0
DEBUG=true

# =============================================================================
# Database (PostgreSQL + asyncpg)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_saas

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# =============================================================================
# JWT Authentication
# =============================================================================
# IMPORTANT: Change this in production! Use a cryptographically random string.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-cryptographically-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# File Uploads (Doctor Documents)
# =============================================================================
UPLOAD_DIR=uploads/doctor_documents
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png

# =============================================================================
# Password Policy
# =============================================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# =============================================================================
# Testing (only used by test suite)
# =============================================================================
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_saas_test
